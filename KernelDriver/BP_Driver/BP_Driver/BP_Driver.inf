;
; BP_Driver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = BP_Driver.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
BP_Driver.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%BP_Driver.DeviceDesc% = BP_Driver_Device, Root\BP_Driver ; TODO: edit hw-id

[BP_Driver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
BP_Driver.sys

;-------------- Service installation
[BP_Driver_Device.NT.Services]
AddService = BP_Driver,%SPSVCINST_ASSOCSERVICE%, BP_Driver_Service_Inst

; -------------- BP_Driver driver install sections
[BP_Driver_Service_Inst]
DisplayName    = %BP_Driver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\BP_Driver.sys

[BP_Driver_Device.NT.Wdf]
KmdfService = BP_Driver, BP_Driver_wdfsect

[BP_Driver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "BP_Driver Installation Disk"
BP_Driver.DeviceDesc = "BP_Driver Device"
BP_Driver.SVCDESC = "BP_Driver Service"
